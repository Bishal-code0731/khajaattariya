# Copy this file to .env and fill in the values.
# .env is bundled INTO the app as an asset, so everything here is public.
# Only public values belong here — never a service-role key, DB password,
# Khalti/eSewa secret key or any other secret (those live in Supabase secrets).

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=

